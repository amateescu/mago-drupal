{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "amateescu/mago-drupal",
  "description": "Mago extension for Drupal: linter rules and analyzer plugins that understand Drupal conventions.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Andrei Mateescu",
      "email": "andrei@amateescu.me"
    }
  ],
  "keywords": [
    "mago",
    "static-analysis",
    "linter",
    "drupal"
  ],
  "require": {
    "php": "^8.1",
    "carthage-software/mago": "^1.47.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0 || ^13.0"
  },
  "autoload": {
    "psr-4": {
      "amateescu\\MagoDrupal\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "amateescu\\MagoDrupal\\Tests\\": "tests/Unit/"
    }
  },
  "config": {
    "allow-plugins": false,
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
