// Reported.
/**
 * Returns one.
 *
 * @throws
 */
function throws_class_one(): int {
  return 1;
}

/**
 * Returns two, with the class on the next line.
 *
 * @throws
 *   \RuntimeException when two is missing.
 */
function throws_class_two(): int {
  return 1;
}

// Fine.
/**
 * Returns one.
 *
 * @throws \RuntimeException
 *   Thrown when one is missing.
 */
function throws_class_one(): int {
  return 1;
}
