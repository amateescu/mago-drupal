<?php

/**
 * @file
 * Exercises the Drupal 7 era rules, which core still enables.
 */

declare(strict_types=1);

/**
 * Implements hook_form_alter().
 *
 * Drupal 7 passed the form state as an array.
 */
// @mago-expect analysis:drupal/hook-form-alter-signature
function legacy_form_alter(array &$form, array $form_state): void {
  // @mago-expect lint:drupal/link-text-translatable
  $form['help'] = l('Read the docs', 'https://example.com');

  $form['ok'] = l(t('Read the docs'), 'https://example.com');

  $topic = t('Forms');

  // A literal followed by a variable is still untranslated.
  // @mago-expect lint:drupal/link-text-translatable
  $form['topic'] = l('Read about ' . $topic, 'https://example.com');

  // A ternary starts with its condition, so Coder reads the literal there.
  // @mago-expect lint:drupal/link-text-translatable
  $form['mode'] = l('Forms' === $topic ? 'Read the docs' : 'Docs', 'https://example.com');

  // The literal is not the first operand.
  $form['suffix'] = l($topic . ' docs', 'https://example.com');

  // Markup at the start is a label, not a sentence.
  $form['markup'] = l('<em>' . $topic . '</em>', 'https://example.com');

  // @mago-expect lint:drupal/watchdog-message
  watchdog('legacy', t('Form altered.'));

  // The named spelling of the message is checked too.
  // @mago-expect lint:drupal/watchdog-message
  watchdog('legacy', message: t('Form altered.'));

  watchdog('legacy', 'Form altered for %form.', ['%form' => 'test']);
}

/**
 * Logs prepared entries.
 *
 * @param list<array{string, string}> $entries
 *   The entries to log.
 */
function legacy_log_batch(array $entries): void {
  foreach ($entries as $entry) {
    // A spread may carry both arguments, so this is not a short call.
    watchdog(...$entry);
  }
}
