<?php

/**
 * @file
 * Exercises const statements after a namespace statement.
 */

declare(strict_types=1);

namespace Drupal\const_namespace;

// @mago-expect lint:drupal/const-prefix
// @mago-expect lint:drupal/global-constant
const CACHE_FLAG = 1;

// @mago-expect lint:drupal/global-constant
const CONST_NAMESPACE_FLAG = 1;
