/**
 * Marks where the procedural hooks of this file end.
 */
#[ProceduralHookScanStop]
function corpus_helpers(): void {
}

/**
 * A helper Drupal's hook collector never takes for an implementation.
 */
function corpus_stopped_thing(): void {
}

/**
 * Lives in the module file without the module name.
 */
// @mago-expect lint:drupal/function-prefix
function helper_without_prefix(): void {
}

/**
 * Starts with an underscore and the module name, which is fine.
 */
function _corpus_helper(): void {
}

/**
 * Prepares variables for a template, which Coder lets through.
 */
function template_preprocess_corpus_page(array &$variables): void {
  $variables['corpus'] = TRUE;
}

/**
 * Has the module name and nothing after its underscore.
 */
// @mago-expect lint:drupal/function-prefix
function corpus_(): void {
}

/**
 * Declares a function in a function, which Coder checks.
 */
function corpus_declares_helper(): void {
  /**
   * Lives in a function without the module name.
   */
  // @mago-expect lint:drupal/function-prefix
  function inner_without_prefix(): void {
  }
}

/**
 * Declares functions in methods, which Coder does not check.
 */
final class CorpusNestedFunctions {

  /**
   * Declares a function when it runs.
   */
  public function build(): object {
    /**
     * Lives in a class method without the module name.
     */
    function nested_without_prefix(): void {
    }

    return new class {

      /**
       * Declares a function when it runs.
       */
      public function build(): void {
        /**
         * Lives in an anonymous class method without the module name.
         */
        function anonymous_without_prefix(): void {
        }
      }

    };
  }

}

// @mago-expect lint:drupal/hook-comment
