<?php

/**
 * @file
 * Exercises the rules that only fire inside a .module file.
 */

declare(strict_types=1);

use Drupal\Core\Cache\CacheableMetadata;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Hook\Attribute\ProceduralHookScanStop;

// @mago-expect lint:drupal/constant-prefix
define('CACHE_LIFETIME', 3600);

// Shares the module name's leading letters but skips the underscore.
// @mago-expect lint:drupal/constant-prefix
define('CORPUSCACHE_TTL', 3600);

define('CORPUS_DEFAULT_LIMIT', 50);

// A #[ProceduralHookScanStop] mention in a comment is not the attribute, so
// the hooks below are still read.

/**
 * Implements hook_install().
 */
// @mago-expect lint:drupal/install-hook-location
function corpus_install(): void {
  \Drupal::state()->set('corpus.installed', TRUE);
}

/**
 * Implements hook_schema().
 */
// @mago-expect lint:drupal/install-hook-location
function corpus_schema(): array {
  return [];
}

/**
 * Implements hook_menu().
 */
function corpus_menu(): array {
  return [
    'admin/corpus' => [
      // @mago-expect lint:drupal/t-in-hook-menu
      'title' => t('Corpus'),
    ],
  ];
}

/**
 * Implements hook_theme().
 */
function corpus_theme(): array {
  global $_corpus_registry;
  // @mago-expect lint:drupal/global-variable
  global $registry;

  $_corpus_registry = [];
  $registry = [];

  return $_corpus_registry + $registry;
}

/**
 * Implements hook_old_thing().
 */
// @mago-expect analysis:drupal/deprecated-hook
function corpus_old_thing(): void {
}

/**
 * Implements hook_new_thing().
 */
function corpus_new_thing(): void {
}

/**
 * Implements hook_later_thing().
 */
function corpus_later_thing(): void {
  // Drupal 13 removes the hook, so the corpus worker's --deprecations=12
  // leaves this implementation alone.
}

/**
 * Implements hook_search_query_TAG_alter().
 */
// @mago-expect analysis:drupal/deprecated-hook
function corpus_search_query_node_access_alter(): void {
}

/**
 * Implements hook_ENTITY_TYPE_view().
 */
function corpus_node_view(): void {
}

/**
 * Implements hook_search_query_TAG_alter() for a tag ending in "view".
 *
 * The entity view alter hook matches the name too, with less text outside its
 * placeholder.
 */
// @mago-expect analysis:drupal/deprecated-hook
function corpus_search_query_node_view_alter(): void {
}

/**
 * Implements hook_field_widget_WIDGET_TYPE_form_alter().
 */
// @mago-expect analysis:drupal/deprecated-hook
function corpus_field_widget_string_textfield_form_alter(): void {
}

/**
 * Implements hook_field_widget_single_element_WIDGET_TYPE_form_alter().
 */
function corpus_field_widget_single_element_string_textfield_form_alter(): void {
}

/**
 * Implements hook_form_FORM_ID_alter() for system_site_information_settings().
 */
function corpus_form_system_site_information_settings_alter(
  array &$form,
  FormStateInterface $form_state,
  string $form_id,
): void {
}

/**
 * Implements hook_form_FORM_ID_alter() for node_form().
 *
 * The form is not taken by reference.
 */
// @mago-expect analysis:drupal/hook-form-alter-signature
function corpus_form_node_form_alter(array $form, FormStateInterface $form_state): void {
}

/**
 * Implements hook_form_FORM_ID_alter() for user_form().
 *
 * Untyped parameters are only checked for the reference.
 */
function corpus_form_user_form_alter(&$form, $form_state): void {
}

/**
 * Implements hook_form_FORM_ID_alter() for user_login_form().
 *
 * Fewer parameters than the module handler passes is fine.
 */
function corpus_form_user_login_form_alter(array &$form): void {
}

/**
 * Implements hook_form_BASE_FORM_ID_alter() for node_article_form().
 *
 * A required fourth parameter is never passed.
 */
// @mago-expect analysis:drupal/hook-form-alter-signature
function corpus_form_node_article_form_alter(
  array &$form,
  FormStateInterface $form_state,
  string $form_id,
  int $extra,
): void {
}

/**
 * Implements hook_form_FORM_ID_alter() for node_page_form().
 *
 * A variadic fourth parameter takes no argument.
 */
function corpus_form_node_page_form_alter(
  array &$form,
  FormStateInterface $form_state,
  string $form_id,
  mixed ...$rest,
): void {
}

/**
 * Implements hook_form_FORM_ID_alter() for user_register_form().
 *
 * Types that take anything the module handler passes are fine.
 */
function corpus_form_user_register_form_alter(mixed &$form, object $form_state, mixed $form_id): void {
}

/**
 * Implements hook_entity_operation().
 */
// @mago-expect analysis:drupal/hook-entity-operation-cacheability
function corpus_entity_operation(EntityInterface $entity): array {
  return [];
}

/**
 * Implements hook_entity_operation_alter().
 */
function corpus_entity_operation_alter(
  array &$operations,
  EntityInterface $entity,
  CacheableMetadata $cacheability,
): void {
}

/**
 * Marks where the procedural hooks of this file end.
 */
#[ProceduralHookScanStop]
function corpus_helpers(): void {
}

/**
 * A helper Drupal's hook collector never takes for an implementation.
 */
function corpus_stopped_thing(): void {
}
