<?php

/**
 * @file
 * Exercises the rules that only fire inside a .module file.
 */

declare(strict_types=1);

// @mago-expect lint:drupal/constant-prefix
define('CACHE_LIFETIME', 3600);

// Shares the module name's leading letters but skips the underscore.
// @mago-expect lint:drupal/constant-prefix
define('CORPUSCACHE_TTL', 3600);

define('CORPUS_DEFAULT_LIMIT', 50);

/**
 * Implements hook_install().
 */
// @mago-expect lint:drupal/install-hook-location
function corpus_install(): void {
  \Drupal::state()->set('corpus.installed', TRUE);
}

/**
 * Implements hook_schema().
 */
// @mago-expect lint:drupal/install-hook-location
function corpus_schema(): array {
  return [];
}

/**
 * Implements hook_menu().
 */
function corpus_menu(): array {
  return [
    'admin/corpus' => [
      // @mago-expect lint:drupal/t-in-hook-menu
      'title' => t('Corpus'),
    ],
  ];
}

/**
 * Implements hook_theme().
 */
function corpus_theme(): array {
  global $_corpus_registry;
  // @mago-expect lint:drupal/global-variable
  global $registry;

  $_corpus_registry = [];
  $registry = [];

  return $_corpus_registry + $registry;
}

/**
 * Lives in the module file without the module name.
 */
// @mago-expect lint:drupal/function-prefix
function helper_without_prefix(): void {
}

/**
 * Starts with an underscore and the module name, which is fine.
 */
function _corpus_helper(): void {
}

/**
 * Prepares variables for a template, which Coder lets through.
 */
function template_preprocess_corpus_page(array &$variables): void {
  $variables['corpus'] = TRUE;
}

/**
 * Has the module name and nothing after its underscore.
 */
// @mago-expect lint:drupal/function-prefix
function corpus_(): void {
}

// @mago-expect lint:drupal/hook-comment
/**
 * Implements corpus_repeat().
 */
function corpus_repeat(): void {
}

// @mago-expect lint:drupal/hook-comment
// @mago-expect lint:drupal/doc-comment
/** Implements corpus_one_line_repeat(). */
function corpus_one_line_repeat(): void {
}

// The second line joins the first without a space, as in Coder.
// @mago-expect lint:drupal/hook-comment
// @mago-expect lint:drupal/doc-comment
/**
 * Implements corpus_wrapped_repeat()
 * .
 */
function corpus_wrapped_repeat(): void {
}

// A tag right under the first line is part of the description.
// @mago-expect lint:drupal/doc-comment
/**
 * Implements corpus_tag_below().
 * @param array $form
 *   The form.
 */
function corpus_tag_below(array $form): void {
}

/**
 * Marks a function.
 */
#[\Attribute(\Attribute::TARGET_FUNCTION)]
final class CorpusHook {}

// @mago-expect lint:drupal/hook-comment
// @mago-expect lint:drupal/function-comment
#[CorpusHook]
/**
 * Implements corpus_after_attribute().
 */
function corpus_after_attribute(): void {
}

/**
 * Implements corpus_before_attribute().
 */
#[CorpusHook]
function corpus_before_attribute(): void {
}

if (!function_exists('corpus_in_block')) {
  /**
   * Implements corpus_in_block().
   */
  function corpus_in_block(): void {
  }
}
