<?php

/**
 * @file
 * Escaped placeholder values.
 */

use Drupal\Component\Utility\Html;
use Drupal\Core\StringTranslation\TranslatableMarkup;

/**
 * Builds token labels.
 */
function example_labels(string $label, int $delta): array {
  return [
    t('@label tokens.', ['@label' => Html::escape($label)]),
    new TranslatableMarkup('@type type with delta @delta', [
      '@type' => Html::escape( $label ),
      '@delta' => $delta,
    ]),
    t('%label', array('%label' => check_plain($label->label(),))),
  ];
}
